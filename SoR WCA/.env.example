# Archivo de ejemplo de variables de entorno
# Copia este archivo a ".env" y ajusta los valores según tu configuración

# --- Servidor ---
PORT=3000
DB_PATH=./data/app.db

# Intervalo de refresco automático de torneos en minutos (WCIF/WCA Live)
POLL_INTERVAL_MINUTES=5

# Clave secreta de sesión (ejemplo: openssl rand -hex 32)
SESSION_SECRET=tu-clave-secreta-aqui

# --- Administrador ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
